--- a/chore/gentests/gentests.go	(revision acd85672ddb3524f08c0f4a670ba52adaa9605c7)
+++ b/chore/gentests/gentests.go	(date 1776432788849)
@@ -17,6 +17,7 @@
 package main
 
 import (
+	"bufio"
 	"fmt"
 	"os"
 	"path/filepath"
@@ -50,6 +51,12 @@
 			continue
 		}
 		testDir := dir + "/" + name
+		skip, err := dirHasLITTESTSource(testDir)
+		check(err)
+		if skip {
+			fmt.Fprintln(os.Stderr, "skip llgen", testDir, "(// LITTEST)")
+			continue
+		}
 		fmt.Fprintln(os.Stderr, "llgen", testDir)
 		check(os.Chdir(testDir))
 		llgen.SmartDoFile(testDir)
@@ -98,3 +105,45 @@
 		panic(err)
 	}
 }
+
+func dirHasLITTESTSource(dir string) (bool, error) {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return false, err
+	}
+	for _, entry := range entries {
+		if entry.IsDir() {
+			continue
+		}
+		name := entry.Name()
+		if filepath.Ext(name) != ".go" || strings.HasSuffix(name, "_test.go") {
+			continue
+		}
+		ok, err := hasLITTESTMarker(filepath.Join(dir, name))
+		if err != nil {
+			return false, err
+		}
+		if ok {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+func hasLITTESTMarker(path string) (bool, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return false, err
+	}
+	defer f.Close()
+
+	scanner := bufio.NewScanner(f)
+	if !scanner.Scan() {
+		return false, scanner.Err()
+	}
+	line := strings.TrimSpace(scanner.Text())
+	if !strings.HasPrefix(line, "//") {
+		return false, nil
+	}
+	return strings.TrimSpace(strings.TrimPrefix(line, "//")) == "LITTEST", nil
+}
